# Required for gated Hugging Face models and hosted inference.
HF_TOKEN=

# Use a verified Dinka-compatible NLLB checkpoint.
MT_MODEL=Alaak/dinka-nllb-600m
MT_FALLBACK=facebook/nllb-200-distilled-600M
DIK_LANG=dik_Latn
EN_LANG=eng_Latn

LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
TTS_MODEL=facebook/mms-tts-dik

# Comma-separated production frontend origins. Leave empty to disable browser CORS.
ALLOWED_ORIGINS=http://localhost:3000
# Set a long random secret to enable admin-only correction endpoint.
ADMIN_API_KEY=

# Lazy-loaded speech-to-text model for POST /api/listen (downloaded on first use).
ASR_MODEL=openai/whisper-small
MAX_AUDIO_BYTES=10485760
CORRECTION_QUEUE_PATH=data/correction_submissions.jsonl

MAX_SESSION_TURNS=20
MAX_SESSIONS=2000
SESSION_TTL_SECONDS=86400
MAX_AUDIO_CHARS=400
MAX_INPUT_TOKENS=256
LOG_LEVEL=INFO
